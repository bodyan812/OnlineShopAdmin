{% set medias = field.value %}
{% if medias is iterable and medias is not empty %}
    {% set html_id = 'ea-lightbox-' ~ field.uniqueId %}

    <div class="gallery">
        {% set firstMedia = medias|first %}
        <img src="{{ vich_uploader_asset(firstMedia, 'file') }}" alt="Фото" style="max-width: 100px; max-height: 100px;">
        <div class="overlay" onclick="openModal('{{ html_id }}')">
            {{ medias|length }}
        </div>
    </div>

    <div id="{{ html_id }}" class="modal modal-gallery">
        <div class="modal-content modal-gallery-content">
            <span class="modal-close modal-gallery-close" onclick="closeModal('{{ html_id }}')">&times;</span>
            <div id="carousel-{{ html_id }}" class="carousel slide">
                <div class="carousel-inner">
                    {% for media in medias %}
                        <div class="carousel-item{% if loop.first %} active{% endif %}">
                            <img src="{{ vich_uploader_asset(media, 'file') }}" alt="Media {{ loop.index }}" style="max-width: 100%;">
                        </div>
                    {% endfor %}
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#carousel-{{ html_id }}" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carousel-{{ html_id }}" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </div>
    </div>
{% endif %}
